<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body class="fk-page">
  <div class="fk-bg-gradient"></div>

  <%- include('partials/minimal-header') %>
  <%- include('partials/cart') %>

  <div class="fk-layout">
    <div class="fk-media-col">
      <div class="fk-media-frame">
        <div class="fk-look active" data-look="0" data-before="/images/bracken-before.jpg" data-after="/images/bracken-after.jpg">
          <img src="/images/bracken-before.jpg" alt="Bracken look" class="fk-look-img">
        </div>
        <div class="fk-look" data-look="1" data-before="/images/bracken-noir-before.jpg" data-after="/images/bracken-noir-after.jpg">
          <img src="/images/bracken-noir-before.jpg" alt="Bracken Noir look" class="fk-look-img">
        </div>
        <div class="fk-look" data-look="2" data-before="/images/birch-before.jpg" data-after="/images/birch-after.jpg">
          <img src="/images/birch-before.jpg" alt="Birch look" class="fk-look-img">
        </div>
        <div class="fk-look" data-look="3" data-before="/images/firth-before.jpg" data-after="/images/firth-after.jpg">
          <img src="/images/firth-before.jpg" alt="Firth look" class="fk-look-img">
        </div>
        <div class="fk-look" data-look="4" data-before="/images/cairn-before.jpg" data-after="/images/cairn-after.jpg">
          <img src="/images/cairn-before.jpg" alt="Cairn look" class="fk-look-img">
        </div>

        <span class="fk-look-name">Bracken</span>

        <div class="fk-gallery-pill">
          <button type="button" class="fk-thumb active" data-goto="0" style="background-image:url(/images/bracken-after.jpg)" aria-label="Bracken"></button>
          <button type="button" class="fk-thumb" data-goto="1" style="background-image:url(/images/bracken-noir-after.jpg)" aria-label="Bracken Noir"></button>
          <button type="button" class="fk-thumb" data-goto="2" style="background-image:url(/images/birch-after.jpg)" aria-label="Birch"></button>
          <button type="button" class="fk-thumb" data-goto="3" style="background-image:url(/images/firth-after.jpg)" aria-label="Firth"></button>
          <button type="button" class="fk-thumb" data-goto="4" style="background-image:url(/images/cairn-after.jpg)" aria-label="Cairn"></button>
        </div>

        <button type="button" class="fk-ba-toggle" data-state="before">
          <span class="fk-ba-option active" data-val="before">Before</span>
          <span class="fk-ba-option" data-val="after">After</span>
        </button>
      </div>
    </div>

    <aside class="fk-info-col">
      <span class="fk-eyebrow">Field Notes LUTs</span>
      <h1 class="fk-title">iPhone Field Kit</h1>
      <p class="fk-desc">Five cinematic looks, built and tested on iPhone. Colours stay balanced for a finished look without changing the feel of the original photo &mdash; use them as they are, or adjust to match your own style.</p>

      <div class="fk-meta-row">
        <div><strong>5 LUTs</strong><span>.cube format</span></div>
        <div><strong>Photomator</strong><span>native import</span></div>
        <div><strong>Davinci</strong><span>Resolve 21+ photo mode</span></div>
      </div>

      <div class="fk-price-row">
        <span class="fk-price" data-price-display="iphone-field-kit">&pound;11.99</span>
        <button type="button" class="fk-add-btn" data-cart-add
          data-id="iphone-field-kit"
          data-name="iPhone Field Kit"
          data-price="11.99"
          data-image="/images/field-kit-cover-wide.jpg"
          data-checkout="https://buy.stripe.com/28EaEZ76I9rt84nbeR6AM01">
          Add to Cart
        </button>
      </div>

      <p class="fk-note">Instant digital delivery by email. All sales are final &mdash; no refunds. Checkout is handled securely by Stripe &mdash; by purchasing you agree to Stripe's terms and our own <a href="/terms-and-conditions">Terms &amp; Conditions</a>. Prefer to pay directly? <a href="https://buy.stripe.com/28EaEZ76I9rt84nbeR6AM01" target="_blank" rel="noopener" data-direct-link="iphone-field-kit">Buy with Stripe</a>.</p>
    </aside>
  </div>

  <%- include('partials/scripts') %>
  <script>
    (function () {
      const looks = document.querySelectorAll('.fk-look');
      const thumbs = document.querySelectorAll('.fk-thumb');
      const nameEl = document.querySelector('.fk-look-name');
      const baToggle = document.querySelector('.fk-ba-toggle');
      const baOptions = document.querySelectorAll('.fk-ba-option');
      const names = ['Bracken', 'Bracken Noir', 'Birch', 'Firth', 'Cairn'];
      let current = 0;
      let baState = 'before';

      function applyImage() {
        const look = looks[current];
        const img = look.querySelector('.fk-look-img');
        img.src = look.dataset[baState];
      }
      function goTo(i) {
        current = i;
        looks.forEach((el, idx) => el.classList.toggle('active', idx === i));
        thumbs.forEach((el, idx) => el.classList.toggle('active', idx === i));
        nameEl.textContent = names[i];
        applyImage();
      }
      thumbs.forEach((thumb) => thumb.addEventListener('click', () => goTo(Number(thumb.dataset.goto))));

      baToggle.addEventListener('click', () => {
        baState = baState === 'after' ? 'before' : 'after';
        baToggle.dataset.state = baState;
        baOptions.forEach((opt) => opt.classList.toggle('active', opt.dataset.val === baState));
        applyImage();
      });
    })();
  </script>
</body>
</html>
