<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/cursor') %>
  <%- include('partials/nav') %>

  <!-- Hero -->
  <section class="pitch-hero pitch-hero-gradient">
    <div class="pitch-hero-inner reveal">
      <span class="pitch-hero-badge">Get Involved</span>
      <h1 class="pitch-hero-title">Casting Calls</h1>
      <p class="pitch-hero-logline">Two ways to work with Braxton Studios: join the creator collective, or step into a specific shoot.</p>
    </div>
  </section>

  <!-- Cards -->
  <section class="casting-hub-section">
    <div class="casting-hub-inner">
      <a href="/casting/university-student" class="casting-hub-card reveal">
        <div class="casting-hub-card-img">
          <img src="/images/irix_braxton studios.JPG" alt="University Student open call">
        </div>
        <div class="casting-hub-card-content">
          <span class="casting-hub-card-eyebrow">Open Call</span>
          <h3 class="casting-hub-card-title">University Student</h3>
          <p class="casting-hub-card-desc">Feature in a YouTube short-form video for a brand open call. Shot in Glasgow/Edinburgh.</p>
        </div>
      </a>
      <a href="/creucast" class="casting-hub-card reveal reveal-delay-1">
        <div class="casting-hub-card-img">
          <img src="/images/creucast.jpg" alt="Creucast">
        </div>
        <div class="casting-hub-card-content">
          <span class="casting-hub-card-eyebrow">Creator Collective</span>
          <h3 class="casting-hub-card-title">Creucast</h3>
          <p class="casting-hub-card-desc">Monthly content days. Crew for each other, on a 6-month commitment.</p>
        </div>
      </a>
    </div>
  </section>

  <%- include('partials/signup') %>
  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
