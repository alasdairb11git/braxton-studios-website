<!-- Cart -->
<div class="cart-overlay" id="cartOverlay"></div>
<aside class="cart-drawer" id="cartDrawer" aria-hidden="true">
  <div class="cart-drawer-header">
    <span class="cart-drawer-title">Your Cart</span>
    <button type="button" class="cart-drawer-close" id="cartClose" aria-label="Close cart">&times;</button>
  </div>
  <div class="cart-drawer-items" id="cartItems"></div>
  <div class="cart-drawer-footer">
    <div class="cart-subtotal">
      <span>Subtotal</span>
      <span class="cart-subtotal-amount" id="cartSubtotal">&pound;0.00</span>
    </div>
    <a href="#" class="cart-checkout-btn" id="cartCheckout">Checkout</a>
    <p class="cart-checkout-note">Instant digital delivery by email. All sales are final &mdash; no refunds. Secure checkout via Stripe. By purchasing you agree to our <a href="/terms-and-conditions">Terms &amp; Conditions</a>.</p>
  </div>
</aside>
