<section class="page-section" id="about">
  <div class="about-inner">
    <div class="about-eyebrow reveal">Who We Are</div>
    <h2 class="about-heading reveal">Scotland's<br>Creative Studio.</h2>
    <div class="about-body">
      <div class="about-text-block">
        <p class="about-text reveal">
          <strong>Braxton Studios</strong> is a Scottish digital entertainment studio built for brands, creators, and stories that deserve to be seen. We produce and develop original productions, and build YouTube strategies that turn channels into standout networks.
        </p>
        <p class="about-text reveal reveal-delay-1" style="margin-top:24px">
          From short film development to luxury brand campaigns, we handle everything from strategy to screen, pairing the craft of filmmaking with the intelligence of platform strategy.
        </p>
        <p class="about-text reveal reveal-delay-1" style="margin-top:24px">
          Based in Scotland. Built for everywhere.
        </p>
        <a href="/about/alasdair-braxton" class="about-media-kit reveal reveal-delay-1" style="margin-top:24px;">Meet Our Founder</a>
      </div>
      <div class="about-right reveal reveal-delay-2">
        <div class="about-contact">
          <span class="about-contact-label">Work With Us</span>
          <a href="mailto:<%= contactEmail %>" class="about-contact-link"><%= contactEmail %></a>
          <!-- <a href="#" class="about-media-kit" target="_blank">Download Media Kit</a> -->
        </div>
        <form id="contactForm" class="contact-form">
          <input type="text" name="name" placeholder="Your Name" required>
          <input type="email" name="email" placeholder="Your Email" required>
          <textarea name="message" placeholder="Tell us about your project..." required></textarea>
          <button type="submit">Send Message</button>
          <div id="formMessage"></div>
        </form>
      </div>
    </div>
  </div>
</section>
