<section class="stories-section">
  <div class="stories-header reveal">
    <div class="stories-header-left">
      <h2 class="section-heading">STORIES</h2>
    </div>
    <a href="/stories" class="stories-all-btn">ALL STORIES <span>&rsaquo;</span></a>
  </div>

  <div class="stories-grid">
<% stories.forEach(function(story, i) { %>
    <a href="<%= story.href %>" class="story-card reveal reveal-delay-<%= i + 1 %>">
      <div class="story-img-wrap">
        <% if (story.placeholder) { %>
        <div class="story-img story-placeholder">
          <span class="story-placeholder-label">Image Coming Soon</span>
        </div>
        <% } else { %>
        <img src="<%= story.img %>" alt="<%= story.alt %>" class="story-img<%= story.imgClass ? ' ' + story.imgClass : '' %>">
        <% } %>
        <span class="story-category"><%= story.category %></span>
      </div>
      <div class="story-info">
        <h3 class="story-title"><%= story.title %></h3>
        <span class="story-date"><%= story.date %></span>
      </div>
    </a>
<% }); %>
  </div>

  <div class="stories-nav">
    <button class="stories-nav-btn stories-prev" aria-label="Previous story">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8L10 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button class="stories-nav-btn stories-next" aria-label="Next story">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
</section>
