<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/cursor') %>
  <%- include('partials/nav') %>

  <section class="listing-hero">
    <div class="listing-hero-content reveal">
      <span class="cs-hero-eyebrow">Original Productions</span>
      <h1 class="cs-hero-title">Films</h1>
      <p class="audit-hero-sub">Short films, feature films, and cinematic storytelling.</p>
    </div>
  </section>

  <section class="listing-grid">
    <a href="/films/tedrad" class="listing-card reveal">
      <div class="listing-card-img">
        <img src="/images/DUNURE BEACH TEDRAD.JPG" alt="Tedrad" style="object-position: center 40%;">
        <div class="listing-card-overlay"></div>
      </div>
      <div class="listing-card-info">
        <h2 class="listing-card-title">Tedrad</h2>
        <p class="listing-card-sub">Short Film — In-Development</p>
      </div>
    </a>
    <a href="/films/the-flatwarming" class="listing-card reveal reveal-delay-1">
      <div class="listing-card-img">
        <img src="/images/the-flatwarming.jpg" alt="The Flatwarming">
        <div class="listing-card-overlay"></div>
      </div>
      <div class="listing-card-info">
        <h2 class="listing-card-title">The Flatwarming</h2>
        <p class="listing-card-sub">Short Film — 2025</p>
      </div>
    </a>
  </section>

  <%- include('partials/signup') %>
  <%- include('partials/footer') %>
  <%- include('partials/scripts') %>
</body>
</html>
