<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="/css/forthside.css">
</head>
<body class="fs-page">

  <header class="fs-top">
    <a href="/" class="fs-top-logo" aria-label="Braxton Studios home">
      <img src="/forthside-concept/braxton-symbol-light.png" alt="Braxton Studios">
    </a>
    <span class="fs-top-tag">Concept for discussion</span>
  </header>

  <main>
    <!-- Hero -->
    <section class="fs-hero">
      <p class="fs-eyebrow">Former MOD Forthside &middot; Stirling</p>
      <h1 class="fs-title">Braxton at <em>Forthside.</em></h1>
      <p class="fs-lede">A concept for a creator and YouTube production base on the Forthside site: a starter unit first, then a purpose-built Creator Block. Move around the site below, then step inside each studio.</p>
      <ul class="fs-facts">
        <li><strong>34 acre</strong><span>former MOD site</span></li>
        <li><strong>Phase 1</strong><span>Starter unit &middot; Studio B &middot; 204 m&sup2;</span></li>
        <li><strong>Phase 2</strong><span>Creator Block &middot; Studio A &middot; 1,620 m&sup2;</span></li>
      </ul>
    </section>

    <!-- Film -->
    <section class="fs-section" id="film">
      <div class="fs-head">
        <p class="fs-eyebrow">The concept</p>
        <h2 class="fs-h2">Concept film</h2>
      </div>
      <!-- Holding image: the film plays in its place when the play button is pressed.
           Swap the holding image by replacing /forthside-concept/film-holding.jpg -->
      <div class="fs-film" data-src="/forthside-concept/braxton-forthside-concept.mp4" data-poster="/forthside-concept/film-holding.jpg">
        <img src="/forthside-concept/film-holding.jpg" alt="Concept film holding image" width="1920" height="1080">
        <button type="button" class="fs-play" aria-label="Play the concept film">
          <svg width="26" height="30" viewBox="0 0 26 30" fill="currentColor" aria-hidden="true"><path d="M2 2l22 13L2 28z"/></svg>
        </button>
      </div>
    </section>

    <!-- Whole site -->
    <section class="fs-section" id="site">
      <div class="fs-head">
        <p class="fs-eyebrow">Explore</p>
        <h2 class="fs-h2">The site</h2>
        <p class="fs-copy">Orbit the whole site, then fly to the Starter unit or the Creator Block. Pick a room to highlight it, and move the sun or building height to see how it sits.</p>
      </div>
      <div class="fs-embed">
        <iframe data-hide-title data-src="/forthside-concept/forthside-3d.html" title="Interactive 3D model of the Forthside site" allowfullscreen></iframe>
        <button type="button" class="fs-shield" hidden>Tap to explore the model</button>
      </div>
      <p class="fs-open"><a href="/forthside-concept/forthside-3d.html" target="_blank" rel="noopener">Open full screen</a></p>
    </section>

    <!-- Studio A -->
    <section class="fs-section" id="studio">
      <div class="fs-head">
        <p class="fs-eyebrow">Inside the Creator Block</p>
        <h2 class="fs-h2">Studio A</h2>
        <p class="fs-copy">Four sets in one room. Switch between views, change the lens and frame, and try the lighting and cyc paint.</p>
      </div>
      <div class="fs-embed">
        <iframe data-src="/forthside-concept/studio-a.html" title="Interactive 3D mock-up of Studio A" allowfullscreen></iframe>
        <button type="button" class="fs-shield" hidden>Tap to explore the studio</button>
      </div>
      <p class="fs-open"><a href="/forthside-concept/studio-a.html" target="_blank" rel="noopener">Open full screen</a></p>
    </section>

    <!-- Studio B -->
    <section class="fs-section" id="studio-b">
      <div class="fs-head">
        <p class="fs-eyebrow">Inside the Starter unit</p>
        <h2 class="fs-h2">Studio B</h2>
        <p class="fs-copy">One set, three looks. Walk in from the lobby, then try the desk, interview and Shorts cameras through different lenses.</p>
      </div>
      <div class="fs-embed">
        <iframe data-src="/forthside-concept/studio-b.html" title="Interactive 3D mock-up of Studio B" allowfullscreen></iframe>
        <button type="button" class="fs-shield" hidden>Tap to explore the studio</button>
      </div>
      <p class="fs-open"><a href="/forthside-concept/studio-b.html" target="_blank" rel="noopener">Open full screen</a></p>
    </section>

    <!-- Close -->
    <section class="fs-section fs-close">
      <p class="fs-eyebrow">Next step</p>
      <h2 class="fs-h2">Talk to us</h2>
      <p class="fs-copy">This is a working concept, not a final plan. If it is useful, we would be glad to walk through it.</p>
      <a class="fs-btn" href="mailto:<%= typeof contactEmail !== 'undefined' ? contactEmail : 'info@braxtonstudios.com' %>?subject=Braxton%20at%20Forthside">Get in touch</a>
    </section>
  </main>

  <footer class="fs-foot">
    <p>Site footprints from OpenStreetMap, &copy; contributors, ODbL. Building heights are guesses, not survey data. Rooms and kit are concept allocations and suggestions, not a specification.</p>
    <p>&copy; <%= new Date().getFullYear() %> Braxton Studios</p>
  </footer>

  <script>
    (function () {
      // ---- Film: holding image until played ----
      var film = document.querySelector('.fs-film');
      if (film) {
        var original = film.innerHTML;
        film.addEventListener('click', function (e) {
          if (!e.target.closest('.fs-play')) return;
          var v = document.createElement('video');
          v.controls = true; v.autoplay = true; v.playsInline = true;
          v.poster = film.dataset.poster; v.src = film.dataset.src;
          v.addEventListener('error', function () { film.innerHTML = original; });
          film.innerHTML = ''; film.appendChild(v);
        });
      }

      // ---- 3D embeds: load when near view, fit height on phones, tap-to-explore on touch ----
      var touch = matchMedia('(hover: none) and (pointer: coarse)');
      var PHONE_VIEW_PX = 440;

      document.querySelectorAll('.fs-embed').forEach(function (box) {
        var frame = box.querySelector('iframe');
        var shield = box.querySelector('.fs-shield');
        var active = false;

        function load() { if (!frame.getAttribute('src')) frame.src = frame.dataset.src; }
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (entries, obs) {
            if (entries[0].isIntersecting) { load(); obs.disconnect(); }
          }, { rootMargin: '300px' }).observe(box);
        } else { load(); }

        frame.addEventListener('load', function () {
          var doc = frame.contentDocument, win = frame.contentWindow;
          if (!doc || !doc.body) return;
          var view = doc.querySelector('.view');

          // Same-origin: size the 3D view in px so the frame can be sized to its content without a feedback loop.
          var st = doc.createElement('style');
          st.textContent = '@media (max-width:820px){.view{min-height:' + PHONE_VIEW_PX + 'px!important}}'
            + 'header img{display:none!important}'
            + (frame.hasAttribute('data-hide-title') ? 'header>div:not(.tabs){display:none!important}.tabs{margin-left:0!important}' : '');
          doc.head.appendChild(st);

          function fit() {
            var app = doc.querySelector('.app');
            if (win.innerWidth <= 820) frame.style.height = Math.ceil(app ? app.getBoundingClientRect().height : doc.documentElement.scrollHeight) + 'px';
            else frame.style.height = '';
            placeShield();
          }
          function placeShield() {
            if (!shield || !view) return;
            var on = touch.matches && !active;
            shield.hidden = !on;
            if (!on) return;
            var r = view.getBoundingClientRect();
            shield.style.left = r.left + 'px'; shield.style.top = r.top + 'px';
            shield.style.width = r.width + 'px'; shield.style.height = r.height + 'px';
          }
          if (shield) shield.addEventListener('click', function () { active = true; shield.hidden = true; });

          if (win.ResizeObserver) new win.ResizeObserver(fit).observe(doc.body);
          if ('ResizeObserver' in window) new ResizeObserver(fit).observe(box);
          window.addEventListener('resize', fit);
          fit();
        });
      });
    })();
  </script>
</body>
</html>
